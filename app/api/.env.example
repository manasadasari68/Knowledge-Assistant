DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/utility_knowledge

# OpenRouter credentials and endpoint used by embeddings and answer generation.
EMBEDDING_API_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=

# OpenRouter chat-completion model. Override as needed.
LLM_MODEL=openai/gpt-4o-mini

# Semantic retrieval settings for chat (pgvector cosine similarity).
# Top-k is capped at 20; the default balances context coverage and relevance.
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_MIN_KEYWORD_SCORE=0.10

